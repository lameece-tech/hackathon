# Copy to .env.local and restart the dev server. Filming needs all three of these: the story
# model, the image model that builds the family into each shot from the captured photo, and the
# video model that animates them. Without them RoomTale casts everyone, then says what's missing.
OPENAI_API_KEY=

# Building the family into each shot sends their photo cutouts (often children) to the image
# provider. Only enable it with consent and a privacy policy that says so; the Little camera
# capability reason must match.
ALLOW_PERSON_REFERENCES=true

# fal.ai can do both halves alone: Nano Banana Pro builds the family into each shot, and
# Seedance 2.5 films it from that frame plus everyone's real photos (faces stay theirs).
# Seedance costs about $0.46 per second of film at 720p (about $0.21 at 480p).
# FAL_KEY=
# SCENE_PROVIDER=fal
# VIDEO_PROVIDER=fal
# FAL_IMAGE_RESOLUTION=2K              # 1K | 2K | 4K
# FAL_VIDEO_RESOLUTION=720p            # 480p | 720p | 1080p (768P for MiniMax)
# FAL_VIDEO_MODEL=bytedance/seedance-2.5/us/reference-to-video
#   or minimax/h3-max-turbo/image-to-video: much cheaper and faster, but it only sees the frame

# Image-to-video for every shot. Runway is the default when its key is set (RUNWAYML_API_SECRET
# works too); VIDEO_PROVIDER=sora uses OpenAI's Videos API with the OpenAI key instead.
# Without OPENAI_API_KEY, Runway also builds the family into each shot, so it can film alone
# (the screenplay then comes from RoomTale's built-in story templates).
RUNWAY_API_KEY=
# VIDEO_PROVIDER=runway
# RUNWAY_VIDEO_MODEL=gen4.5            # or gen4_turbo (faster, cheaper); see docs.dev.runwayml.com/guides/models
# RUNWAY_IMAGE_MODEL=gpt_image_2       # takes up to 16 reference images
# OPENAI_VIDEO_MODEL=sora-2

# Optional overrides.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_STORY_MODEL=gpt-4o
# OPENAI_IMAGE_EDIT_MODEL=gpt-image-1  # builds the family into each shot
# OPENAI_IMAGE_QUALITY=medium          # low | medium | high
# OPENAI_IMAGE_INPUT_FIDELITY=high     # set empty to omit
